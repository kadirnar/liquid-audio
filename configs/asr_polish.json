{
  "model_id": "outputs/asr-lora/final",
  "output_dir": "outputs/asr-polish",
  "max_steps": 2500,
  "warmup_ratio": 0.03,
  "batch_size": 1,
  "gradient_accumulation_steps": 16,
  "learning_rate": 0.00003,
  "audio_encoder_lr_scale": 0.1,
  "weight_decay": 0.05,
  "min_lr_ratio": 0.1,
  "max_grad_norm": 0.5,
  "mixed_precision": "auto",
  "trainable_parameters_fp32": true,
  "seed": 43,
  "dataloader_num_workers": 4,
  "logging_interval": 10,
  "save_interval": 125,
  "validation_interval": 125,
  "checkpoint_limit": 3,
  "early_stopping_patience": 6,
  "gradient_checkpointing": true,
  "allow_tf32": true,
  "text_label_smoothing": 0.02,
  "audio_label_smoothing": 0.0,
  "end_token_weight": 2.0,
  "text_loss_multiplier": 1.0,
  "audio_loss_multiplier": 0.0,
  "log_jsonl": true,
  "fine_tune": {
    "strategy": "asr_lora",
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "lora_dropout": 0.03,
    "lora_target_modules": ["q_proj", "k_proj", "v_proj", "out_proj", "w1", "w2", "w3"],
    "train_audio_encoder": true,
    "train_audio_adapter": true,
    "train_tts_head": false,
    "train_text_embeddings": false,
    "train_layer_norms": true,
    "train_biases": false,
    "unfreeze_last_lfm_layers": 0
  },
  "specaugment": {
    "probability": 0.4,
    "time_masks": 1,
    "max_time_width": 40,
    "max_time_ratio": 0.04,
    "frequency_masks": 1,
    "max_frequency_width": 10
  }
}
